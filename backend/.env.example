# Copy to .env (gitignored) and fill in, then run:
#   uvicorn app.main:app --reload --port 8000 --env-file .env
# Everything here is optional: without it, guests can still play but nothing is saved.

# Clerk dashboard > API keys > JWKS URL
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# The sites allowed to send sign-in tokens, comma-separated
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Neon (or any Postgres) connection string. For a quick local test, a SQLite
# file works too: DATABASE_URL=sqlite:///data/app.sqlite
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
